{
  "name": "blitzsplit-site",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /g/* (an invite's meta tags), /og/* (its preview's image), /.well-known/* and /legal/* (a 404 for a file the
    // site doesn't have) run src/index.js; every other path is a static file. Any other unknown page answers with
    // the landing.
    "run_worker_first": ["/g/*", "/og/*", "/.well-known/*", "/legal/*"],
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "vars": {
    // The API's edge function that answers what an invite link's preview shows (blitz-split-api).
    "INVITE_PREVIEW_URL": "https://cfgnuyijsncgpgywoldf.supabase.co/functions/v1/invite-preview"
  },
  "routes": [
    { "pattern": "blitzsplit.com", "custom_domain": true },
    { "pattern": "www.blitzsplit.com", "custom_domain": true }
  ]
}
