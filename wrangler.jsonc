{
  "name": "blitzsplit-site",
  "compatibility_date": "2026-10-01",
  // Runs only for the app links, which it redirects to the web app.
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Any other unknown page answers with the landing.
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    // Never /.well-known/*: Android and Apple need its files with a 200 and no redirect.
    "run_worker_first": ["/g/*", "/b/*", "/c/*"]
  },
  "vars": {
    // Where a browser opens an app link: the beta web app, until app.blitzsplit.com serves it.
    "WEB_APP_URL": "https://blitz-split-beta.pages.dev"
  },
  "routes": [
    { "pattern": "blitzsplit.com", "custom_domain": true },
    { "pattern": "www.blitzsplit.com", "custom_domain": true }
  ]
}
