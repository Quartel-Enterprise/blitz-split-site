{
  "name": "blitzsplit-site",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /g/* (an invite's meta tags), /c/* (a bill's link's), /u/* (a profile's), /b/* (a comment's link's), the
    // download paths, /og/* (a preview's image), /.well-known/* and /legal/* (a 404 for a file the site doesn't have)
    // run src/index.js; every other path is a static file. Any other unknown page answers with the landing.
    "run_worker_first": [
      "/g/*",
      "/c/*",
      "/u/*",
      "/b/*",
      "/download",
      "/download/*",
      "/app-download",
      "/app-download/",
      "/og/*",
      "/.well-known/*",
      "/legal/*"
    ],
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "vars": {
    // The API's edge function that answers what a link's preview shows: an invite's, a bill's, a profile's and the
    // cards that are the same for every address (a comment's link, the download paths, the legal pages)
    // (blitz-split-api).
    "INVITE_PREVIEW_URL": "https://cfgnuyijsncgpgywoldf.supabase.co/functions/v1/invite-preview"
  },
  "routes": [
    { "pattern": "blitzsplit.com", "custom_domain": true },
    { "pattern": "www.blitzsplit.com", "custom_domain": true }
  ]
}
